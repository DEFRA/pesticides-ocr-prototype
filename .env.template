# GOV.UK Prototype Kit Environment variables

#PASSWORD=
#PASSWORD_KEYS=

# Add your own environment variables below

# Address lookup API. An access token is fetched with the client credentials
# below and cached in memory until it expires.
#OS_NAMES_API_URL=
#OS_NAMES_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
#OS_NAMES_SCOPE=api://<app-id>/.default
#OS_NAMES_CLIENT_ID=
#OS_NAMES_CLIENT_SECRET=
